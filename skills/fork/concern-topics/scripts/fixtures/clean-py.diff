+import logging
+from dataclasses import dataclass
+from enum import Enum
+
+logger = logging.getLogger(__name__)
+
+SEAT_SYNC_TIMEOUT_S = 10
+
+
+class SeatChangeKind(Enum):
+    ADDED = "added"
+    REMOVED = "removed"
+
+
+@dataclass(frozen=True)
+class SeatChange:
+    kind: SeatChangeKind
+    user_id: str
+
+
+def load_seats(org_id: str) -> list[Seat]:
+    try:
+        return seats_repo.list(org_id, timeout=SEAT_SYNC_TIMEOUT_S)
+    except RepoUnavailable as exc:
+        logger.exception("seat list failed for org %s", org_id)
+        raise SeatsUnavailable(org_id) from exc

@@ -0,0 +1,25 @@
+import { SEAT_SYNC_TIMEOUT_MS } from "./limits";
+
+export type SeatChange =
+  | { kind: "added"; userId: UserId }
+  | { kind: "removed"; userId: UserId; at: Date };
+
+export const RETRY_LIMIT = 3;
+
+export async function applySeatChange(change: SeatChange): Promise<Invoice> {
+  const signal = AbortSignal.timeout(SEAT_SYNC_TIMEOUT_MS);
+  switch (change.kind) {
+    case "added":
+      return billing.addSeat(change.userId, { signal });
+    case "removed":
+      return billing.removeSeat(change.userId, change.at, { signal });
+  }
+}
+
+export async function loadSeats(orgId: OrgId): Promise<Seat[]> {
+  try {
+    return await seatsRepo.list(orgId);
+  } catch (err) {
+    throw new SeatsUnavailable(orgId, { cause: err });
+  }
+}

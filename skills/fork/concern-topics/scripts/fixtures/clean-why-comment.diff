+def on_invoice_paid(event: StripeEvent) -> None:
+    # Stripe retries for three days, so a repeat delivery must be a no-op, not an error.
+    balance = ledger.balance_for(event.customer_id)  # type: ignore[attr-defined]
+    try:
+        mirror.write(balance)
+    except MirrorUnavailable:
+        # The mirror is rebuilt nightly; one lost write is cheaper than a failed webhook.
+        pass

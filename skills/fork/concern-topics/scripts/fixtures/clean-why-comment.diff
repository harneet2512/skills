new file mode 100644
--- /dev/null
+++ b/src/webhooks.ts
@@ -0,0 +1,14 @@
+// Stripe retries for three days, so a delivery we already handled must be a no-op, not an error.
+export async function onInvoicePaid(event: StripeEvent): Promise<void> {
+  // The ledger is the source of truth for balances; the event only tells us to re-read it.
+  const balance = await ledger.balanceFor(event.customerId);
+  // @ts-expect-error -- stripe-node 14 types omit `livemode` on test clocks
+  if (event.livemode === false) return;
+  try {
+    await mirror.write(balance);
+  } catch (err) {
+    // The mirror is a cache rebuilt nightly; losing one write is cheaper than failing the webhook.
+    metrics.increment("mirror_write_failed");
+  }
+  await sleep(backoffMs(event.attempt));
+}

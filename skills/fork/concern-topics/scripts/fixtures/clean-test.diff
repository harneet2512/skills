+import { applySeatChange } from "../src/seats";
+
+test("removing a seat bills the remainder", async () => {
+  const invoice = await applySeatChange({ kind: "removed", userId: "u1", at: new Date(0) });
+  console.log(invoice);
+  await new Promise((r) => setTimeout(r, 2000));
+  expect(invoice.lines).toHaveLength(1);
+}, 10000);

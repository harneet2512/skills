{
  "start": ["node", "--no-warnings", "src/server.mjs"],
  "healthz": "/healthz",
  "env": {
    "PORT": "{{port}}",
    "INSTANCE_ID": "{{instance}}",
    "DATABASE_PATH": "{{db}}",
    "SLACK_API_BASE": "{{slack.url}}/api",
    "SLACK_SIGNING_SECRET": "{{secrets.slackSigning}}",
    "GMAIL_API_BASE": "{{gmail.url}}/gmail/v1",
    "PUBSUB_PUSH_TOKEN": "{{secrets.pushToken}}",
    "ADMIN_TOKEN": "{{secrets.adminToken}}",
    "TOKEN_ENC_KEY": "{{secrets.encKey}}",
    "LLM_PROVIDER": "{{llm.provider}}",
    "ANTHROPIC_BASE_URL": "{{llm.url}}",
    "ANTHROPIC_API_KEY": "{{secrets.llmKey}}",
    "HTTP_TIMEOUT_MS": "4000",
    "JOB_LEASE_MS": "5000",
    "JOB_BACKOFF_BASE_MS": "150",
    "JOB_MAX_ATTEMPTS": "5",
    "WORKER_POLL_MS": "25",
    "PROMPT_BUDGET_TOKENS": "3000",
    "GOOGLE_REVOKE_URL": "{{gmail.url}}/revoke",
    "UNINSTALL_PURGE_AFTER_MS": "1500",
    "DRAFT_BUDGET_PER_WINDOW": "12",
    "SHUTDOWN_GRACE_MS": "5000"
  }
}
